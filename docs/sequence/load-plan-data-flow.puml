@startuml
' Full end-user data flow for load plans: login -> read -> create (auto-calculates packing) -> visualize.
' Render with a raised limit (PNG caps at 4096px height by default):
'   PLANTUML_LIMIT_SIZE=12000 plantuml -tpng load-plan-data-flow.puml
title Full User Journey: Load Plan Data Flow

skinparam sequenceParticipantPadding 2
skinparam sequenceBoxPadding 3
skinparam sequencePadding 1
skinparam sequenceMessagePadding 1
skinparam sequenceNotePadding 1
skinparam sequenceGroupMargin 1
skinparam sequenceArrowThickness 1
skinparam DefaultFontSize 8
skinparam ParticipantFontSize 8
skinparam ActorFontSize 8
skinparam ArrowFontSize 8
skinparam MessageFontSize 8
skinparam NoteFontSize 8
skinparam GroupFontSize 8
skinparam GroupHeaderFontSize 8
skinparam GroupMessageFontSize 8
skinparam LifeLineFontSize 8

actor "Planner" as User

box "Web Client" #EAF3FA
  boundary "Web Page (React)" as Page
  control "Auth Context" as AuthCtx
  control "Service Layer" as Svc
  control "API Client" as API
  boundary "StuffingVisualizer" as Viewer
end box

box "StuffingVisualizer Core" #D9E9F7
  control "Scene Manager" as SceneMgr
  control "Camera Manager" as CamMgr
  control "Animation Manager" as AnimMgr
  control "Renderer Manager" as RenderMgr
end box

box "Go API (Gin)" #E8F0FE
  control "JWT + RBAC Middleware" as Mw
  control "AuthHandler" as AuthHdl
  control "AuthService" as AuthSvc
  control "PlanHandler" as PlanHdl
  control "PlanService" as PlanSvc
  control "PackingGateway" as GW
end box

boundary "Packing Engine (Flask/py3dbp)" as Engine
database "PostgreSQL" as DB

== Authentication ==

User -> Page : Enter credentials
activate User
activate Page
Page -> AuthCtx : login(username, password)
activate AuthCtx
AuthCtx -> Svc : AuthService.login()
activate Svc
Svc -> API : apiPost("/auth/login", body)
activate API
API -> AuthHdl : POST /auth/login\n(public, no token)
activate AuthHdl

alt Registered user
  AuthHdl -> AuthSvc : Login(username, password)
  activate AuthSvc
  AuthSvc -> DB : GetUserByUsername + VerifyPassword
  activate DB
  DB --> AuthSvc : user (active workspace, role)
  deactivate DB
  AuthSvc -> AuthSvc : Resolve role + default workspace
  AuthSvc -> AuthSvc : GenerateAccessToken (JWT)\nGenerateRefreshToken
  AuthSvc -> DB : INSERT refresh_tokens
  activate DB
  DB --> AuthSvc : ok
  deactivate DB
  AuthSvc --> AuthHdl : tokens + user + permissions
  deactivate AuthSvc
else Guest trial
  AuthHdl -> AuthSvc : GuestToken()
  activate AuthSvc
  AuthSvc -> AuthSvc : Generate 30-day JWT\n(role: trial, 3-plan limit)
  AuthSvc --> AuthHdl : trial access token
  deactivate AuthSvc
end

note over API, AuthSvc
  POST /auth/login
  req: { "username", "password", "guest_token"? }
  res: { "access_token", "refresh_token",
         "active_workspace_id",
         "user": { "id", "username", "role" } }
end note

AuthHdl --> API : 200 { access_token, refresh_token,\nuser, active_workspace_id }
deactivate AuthHdl
API --> Svc : LoginResponse
deactivate API
Svc --> AuthCtx : tokens + user
deactivate Svc

AuthCtx -> AuthCtx : Persist session to\nlocalStorage

AuthCtx -> Svc : refreshSession()\nAuthService.me()
activate Svc
Svc -> API : apiGet("/auth/me")
activate API
API -> Mw : GET /auth/me\n(Bearer access_token)
activate Mw
Mw -> Mw : Verify JWT + load permissions
Mw -> AuthHdl : GET /auth/me
activate AuthHdl
AuthHdl -> AuthSvc : Me()
activate AuthSvc
AuthSvc --> AuthHdl : user + permissions + workspace
deactivate AuthSvc
AuthHdl --> Mw : 200 me
deactivate AuthHdl
Mw --> API : 200 me
deactivate Mw
API --> Svc : AuthMeResponse
deactivate API
Svc --> AuthCtx : user + permissions + workspace
deactivate Svc
AuthCtx --> Page : session ready
deactivate AuthCtx
Page --> User : Redirect to /dashboard
deactivate Page
deactivate User

== Dashboard & Shipments ==

User -> Page : Opens /dashboard
activate User
activate Page
Page -> Svc : DashboardService.getStats()
activate Svc
Svc -> API : apiGet("/dashboard")
activate API
API -> Mw : GET /dashboard\n(Bearer token)
activate Mw
Mw -> Mw : Verify JWT + RBAC\n(perm: dashboard:read)
Mw -> PlanSvc : DashboardStats()
activate PlanSvc
PlanSvc -> DB : Workspace-scoped queries
activate DB
DB --> PlanSvc : stats (plans, items, utilization)
deactivate DB
PlanSvc --> Mw : dashboard stats
deactivate PlanSvc
Mw --> API : 200 stats
deactivate Mw
API --> Svc : DashboardStatsResponse
deactivate API
Svc --> Page : stats
deactivate Svc
Page --> User : Render dashboard stats
deactivate Page
deactivate User

User -> Page : Navigate to /shipments
activate User
activate Page
Page -> Svc : PlanService.listPlans()
activate Svc
Svc -> API : apiGet("/plans?page=&limit=")
activate API
API -> Mw : GET /plans (paged)\n(Bearer token)
activate Mw
Mw -> Mw : Verify JWT + RBAC\n(perm: plan:read)
Mw -> PlanSvc : ListPlans()
activate PlanSvc
PlanSvc -> DB : SELECT load_plans\n(workspace-scoped)
activate DB
DB --> PlanSvc : plan summaries
deactivate DB
PlanSvc --> Mw : paginated plans
deactivate PlanSvc
Mw --> API : 200 plan list
deactivate Mw
API --> Svc : PlanListItem[]
deactivate API
Svc --> Page : plan list
deactivate Svc
Page --> User : Display plan list
deactivate Page
deactivate User

== Read & Create Plan ==

' Review an existing plan first
User -> Page : Open plan detail\n(/shipments/:id)
activate User
activate Page
Page -> Svc : PlanService.getPlan(id)
activate Svc
Svc -> API : apiGet("/plans/:id")
activate API
API -> Mw : GET /plans/:id\n(Bearer token)
activate Mw
Mw -> Mw : Verify JWT + RBAC\n(perm: plan:read)
Mw -> PlanSvc : GetPlan(id)
activate PlanSvc
PlanSvc -> DB : Fetch plan + items + result\n+ placements (ORDER BY step)
activate DB
DB --> PlanSvc : full plan data
deactivate DB
PlanSvc --> Mw : PlanDetailResponse
deactivate PlanSvc
Mw --> API : 200 plan detail
deactivate Mw
API --> Svc : PlanDetailResponse
deactivate API
Svc --> Page : plan detail
deactivate Svc
Page -> Page : toStuffingPlanData()\nmap to PackedItem[]
Page --> User : Display plan detail\n(items + placements)
deactivate Page
deactivate User

' Create a new plan; create auto-computes the packing
User -> Page : Fill create-plan form\n(container + items)
activate User
activate Page
Page -> Svc : PlanService.createPlan(data)
activate Svc
Svc -> API : apiPost("/plans", body)
activate API
API -> Mw : POST /plans\n(Bearer token)
activate Mw
Mw -> Mw : Verify JWT + RBAC\n(perm: plan:create)
Mw -> PlanHdl : POST /plans
activate PlanHdl
PlanHdl -> PlanSvc : CreateCompletePlan(req)
activate PlanSvc

opt Trial user
  PlanSvc -> DB : Count existing plans
  activate DB
  DB --> PlanSvc : plan count
  deactivate DB
  PlanSvc -> PlanSvc : Enforce limit (max 3 plans)
end

alt Container preset
  PlanSvc -> DB : GetContainer(id)
  activate DB
  DB --> PlanSvc : container dims (mm)
  deactivate DB
else Custom container
  PlanSvc -> PlanSvc : Use dimensions from request
end
PlanSvc -> PlanSvc : Snapshot dims to load_plans\n(no FK reference)

PlanSvc -> DB : INSERT load_plans + load_items\n(workspace_id, snapshots)
activate DB
DB --> PlanSvc : plan_id + item_ids
deactivate DB

opt auto_calculate (default)
  PlanSvc -> DB : Fetch plan + items\n(workspace-scoped)
  activate DB
  DB --> PlanSvc : plan, items (mm, kg)
  deactivate DB
  PlanSvc -> GW : PackRequest\n(units, container, items)
  activate GW
  GW -> Engine : POST /pack
  activate Engine
  note over GW, Engine
    POST /pack
    req: { "units": "mm", "container": { length, width,
          height, max_weight },
          "items": [{ item_id, label, length, width,
          height, weight, quantity }],
          "options": { fix_point, check_stable,
          support_surface_ratio, bigger_first, put_type } }
    res: { "success", "data": {
          "placements": [{ item_id, label, pos_x, pos_y,
          pos_z, rotation, step_number }],
          "unfitted": [{ item_id, label, count }], "stats" } }
  end note
  Note over Engine : py3dbp: mm -> integer cm,\naxes remapped WHD=(L,H,W),\nputOrder assigned, unfitted aggregated
  Engine --> GW : PackResponse\n(placements, unfitted, utilization)
  Note over GW : Axis remap back (x=L, y=W, z=H),\nrotation_code = permutation index,\nstep_number = putOrder + 1
  deactivate Engine
  GW --> PlanSvc : PackResult
  deactivate GW
  PlanSvc -> PlanSvc : Sort + apply rotation,\nrecompute utilization
  alt is_feasible
    PlanSvc -> PlanSvc : status = COMPLETED
  else has unfitted items
    PlanSvc -> PlanSvc : status = PARTIAL
  end
  PlanSvc -> DB : Persist: DELETE + INSERT plan_results,\nCopyFrom plan_placements,\nUPDATE load_plans status
  activate DB
  DB --> PlanSvc : ok
  deactivate DB
end

PlanSvc --> PlanHdl : CreatePlanResponse\n(includes calculation result)
deactivate PlanSvc
PlanHdl --> Mw : 201 Created
deactivate PlanHdl
Mw --> API : 201 plan + items\n+ calculation result
deactivate Mw
API --> Svc : CreatePlanResponse
deactivate API
Svc --> Page : plan created
deactivate Svc
note over API, PlanSvc
  POST /plans
  req: { "title", "notes"?, "auto_calculate": true,
         "container": { "container_id"? OR
           "length_mm", "width_mm", "height_mm", "max_weight_kg" },
         "items": [{ "product_sku"?, "label"?,
           "length_mm", "width_mm", "height_mm",
           "weight_kg", "quantity", "allow_rotation"?, "color_hex"? }] }
  res: { "plan_id", "plan_code", "title", "status",
         "total_items", "total_weight_kg", "total_volume_m3",
         "calculation"?: { "status", "placements": [...],
         "volume_utilization_pct" } }
end note
Page --> User : Redirect to plan detail\nwith packing result
deactivate Page
deactivate User

== Visualize ==

User -> Page : 3D viewport loads
activate User
activate Page
Page -> Viewer : loadData(toStuffingPlanData(plan))
activate Viewer

create ContainerMesh
Viewer -> ContainerMesh : new ContainerMesh(container)\nposition + dimensions
activate ContainerMesh
ContainerMesh --> Viewer : mesh group
deactivate ContainerMesh
Viewer -> SceneMgr : add(containerGroup)
activate SceneMgr
SceneMgr --> Viewer : scene ready
deactivate SceneMgr

loop Each placement
  create ItemMesh
  Viewer -> ItemMesh : new ItemMesh(item, placement)\ncontainer dims
  activate ItemMesh
  ItemMesh -> ItemMesh : getRotatedDims()\ncontainerToThreeCoords()
  ItemMesh --> Viewer : mesh group
  deactivate ItemMesh
  Viewer -> SceneMgr : add(itemGroup)
  activate SceneMgr
  SceneMgr --> Viewer : scene updated
  deactivate SceneMgr
end
Note over ContainerMesh, ItemMesh
  containerToThreeCoords (conversions.ts):
  API (x=length, y=width, z=height) ->
  Three.js (x, -z, y), mm -> meters,
  origin front-left-bottom -> container center
end note

Viewer -> AnimMgr : setMaxStep() +\nsetCurrentStep(maxStep)
activate AnimMgr
AnimMgr --> Viewer : currentStep = maxStep
deactivate AnimMgr
Viewer -> CamMgr : fitToContainer(container)
activate CamMgr
CamMgr --> Viewer : camera auto-fit
deactivate CamMgr
Viewer -> Viewer : updateVisibleItems(maxStep)\nopen at full load
Viewer -> RenderMgr : start render loop
activate RenderMgr
RenderMgr --> Viewer : animating (rAF)
deactivate RenderMgr

Viewer --> Page : rendered scene
deactivate Viewer
Page --> User : Show fully loaded container
deactivate Page
deactivate User

@enduml
